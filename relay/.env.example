ANTHROPIC_API_KEY=
RELAY_DATABASE_URL=postgresql://postgres:relay@localhost:5432/relay
# claude-opus-5-5 is the default; claude-haiku-5-5 is about 40x cheaper for development
RELAY_MODEL=claude-haiku-5-5
# Local development: tokens minted by scripts/dev_token.py. Production: RELAY_AUTH_MODE=jwt with your IdP's JWKS.
RELAY_AUTH_MODE=dev
RELAY_DEV_JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more
# RELAY_JWKS_URL=https://your-tenant.example.com/.well-known/jwks.json
# RELAY_JWT_ISSUER=https://your-tenant.example.com/
